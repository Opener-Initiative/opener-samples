{
	// The configurations debug the active target (sample + board), see
	// scripts/target.py. It copies the target's ELF, hex file and J-Link
	// script to build/active.*. device and svdPath depend on the chip, so
	// there is one pair of configurations per chip.
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug (nRF9151)",
			"type": "cortex-debug",
			"request": "launch",
			"preLaunchTask": "Build",
			"servertype": "jlink",
			"interface": "swd",
			"device": "NRF9151_xxca",
			"serverArgs": [
				"-speed",
				"4000",
				"-jlinkscriptfile",
				"${workspaceFolder}/build/active.JLinkScript"
			],
			"armToolchainPath": "${config:opener.zephyrSdkPath}/arm-zephyr-eabi/bin",
			"toolchainPrefix": "arm-zephyr-eabi",
			"executable": "${workspaceFolder}/build/active.elf",
			"loadFiles": [
				"${workspaceFolder}/build/active.hex"
			],
			"svdPath": "${workspaceFolder}/deps/modules/hal/nordic/nrfx/bsp/stable/mdk/nrf9120.svd",
			"rtos": "Zephyr",
			"runToEntryPoint": "main",
			"rttConfig": {
				"enabled": true,
				"address": "auto",
				"decoders": [
					{
						"label": "RTT",
						"port": 0,
						"type": "console"
					}
				]
			}
		},
		{
			"name": "Attach (nRF9151)",
			"type": "cortex-debug",
			"request": "attach",
			"servertype": "jlink",
			"interface": "swd",
			"device": "NRF9151_xxca",
			"serverArgs": [
				"-speed",
				"4000",
				"-jlinkscriptfile",
				"${workspaceFolder}/build/active.JLinkScript"
			],
			"armToolchainPath": "${config:opener.zephyrSdkPath}/arm-zephyr-eabi/bin",
			"toolchainPrefix": "arm-zephyr-eabi",
			"executable": "${workspaceFolder}/build/active.elf",
			"svdPath": "${workspaceFolder}/deps/modules/hal/nordic/nrfx/bsp/stable/mdk/nrf9120.svd",
			"rtos": "Zephyr",
			"rttConfig": {
				"enabled": true,
				"address": "auto",
				"decoders": [
					{
						"label": "RTT",
						"port": 0,
						"type": "console"
					}
				]
			}
		}
	]
}
