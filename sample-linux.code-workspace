{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		// settings for override in user .vscode/settings.json
		"zephyrSdkPath": "${userHome}/zephyr-sdk-0.17.4",
		"build-folder": "${workspaceFolder}/build/",
		"python.terminal.activateEnvironment": true,
		"python.venvPath": "${workspaceFolder}/.venv",
		"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

		"git.autofetch": false,
		"git.autoRepositoryDetection": true,
		"git.repositoryScanMaxDepth": 3,
		"git.openRepositoryInParentFolders": "always",
		"git.repositoryScanIgnoredFolders": [
			"nrf",
			"nrfxlib",
			"test",
			"tools",
			"modules"
		],
		// Hush CMake
		"cmake.configureOnOpen": false,
		// IntelliSense
		"C_Cpp.errorSquiggles": "enabled",
		"C_Cpp.default.compilerPath": "${config:zephyrSdkPath}/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc",
		"C_Cpp.default.compileCommands": "${config:build-folder}/nrf9151dk/nrf9151/ns/dectnrp-driver/dectnrp-driver/compile_commands.json",
		"C_Cpp.clang_format_path": "${workspaceFolder}/.venv/bin/clang-format",
		// File Associations
		"files.associations": {
			"*.h": "c",
			"*.c": "c",
		},
		"makefile.configureOnOpen": false,
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Build Device",
				"type": "shell",
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"linux": {
					"command": ".venv/bin/west build -b nrf9151dk/nrf9151/ns app/dectnrp-driver/"
				},
				"problemMatcher": [
					"$gcc"
				]
			},
			{
				"label": "Flash Device",
				"type": "shell",
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"linux": {
					"command": ".venv/bin/west flash --build-dir ${config:build-folder}/nrf9151dk/nrf9151/ns/dectnrp-driver/",
				},
				"problemMatcher": [
					"$python"
				]
			},
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Device (launch)",
				"type": "cortex-debug",
				"device": "NRF9151_xxca",
				"executable": "${config:build-folder}/nrf9151dk/nrf9151/ns/dectnrp-driver/dectnrp-driver/zephyr/zephyr.elf",
				"loadFiles": [
					"${config:build-folder}/nrf9151dk/nrf9151/ns/dectnrp-driver/merged.hex"
				],
				"cwd": "${workspaceFolder}",
				"rtos": "Zephyr",
				"request": "launch",
				"runToEntryPoint": "main",
				"servertype": "jlink",
				"interface": "swd",
				"serverArgs": [
					"-speed",
					"4000",
				],
				"gdbPath": "${config:zephyrSdkPath}/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
				"svdPath": "${workspaceFolder}/deps/modules/hal/nordic/nrfx/mdk/nrf9120.svd",
				//"showDevDebugOutput": "raw",
				"rttConfig": { // this automatically opens a rtt viewer terminal
					"enabled": true,
					"address": "auto",
					"decoders": [
						{
							"label": "Device",
							"port": 0,
							"type": "console"
						}
					]
				},
			},
		],
	},
	"extensions": {
		"recommendations": [
			"ms-vscode.cpptools-extension-pack",
			"ms-vscode.cmake-tools",
			"marus25.cortex-debug",
			"ms-python.python",
			"ms-vscode.vscode-serial-monitor",
		]
	}
}
